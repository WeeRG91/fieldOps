# Local environment files; safe examples may be committed
.env
.env.*
!.env.example
!.env.*.example

# Installed dependencies
vendor/
node_modules/

# Laravel generated files
/backend/public/build/
/backend/public/hot
/backend/public/storage
/backend/storage/*.key
/backend/storage/logs/*
!/backend/storage/logs/.gitignore
/backend/storage/framework/cache/*
/backend/storage/framework/sessions/*
/backend/storage/framework/views/*
/backend/bootstrap/cache/*.php

# Local SQLite databases
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Test and coverage output
.phpunit.cache/
.phpunit.result.cache
/coverage/
/backend/coverage/
/mobile/coverage/

# Expo and mobile generated output
/mobile/.expo/
/mobile/dist/
/mobile/web-build/

# Local editor settings
.idea/
.vscode/

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Package-manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
